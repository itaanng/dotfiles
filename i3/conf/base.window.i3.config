gaps outer $gap_width
gaps inner $gap_width
smart_gaps on

default_border pixel $border_width
default_floating_border pixel $border_width
smart_borders on

# kill focused window
bindsym $key_mod+$key_q kill

# Resize window (you can also use the mouse for that)
mode "resize" {
    bindsym $key_left  resize shrink width 10 px or 10 ppt
    bindsym $key_down  resize grow height 10 px or 10 ppt
    bindsym $key_up    resize shrink height 10 px or 10 ppt
    bindsym $key_right resize grow width 10 px or 10 ppt

    bindsym $key_shift+$key_left                gaps horizontal all minus $gap_width
    bindsym $key_shift+$key_down                gaps vertical all plus $gap_width
    bindsym $key_shift+$key_up                  gaps vertical all minus $gap_width
    bindsym $key_shift+$key_right               gaps horizontal all plus $gap_width
    bindsym $key_shift+$key_space               gaps inner all plus $gap_width
    bindsym $key_shift+$key_alt+$key_space      gaps inner all minus $gap_width
    bindsym $key_shift+$key_r                   gaps outer all set $gap_width
    bindsym $key_shift+$key_alt+$key_r          gaps inner all set $gap_width

    bindsym $key_enter mode "default"
    bindsym $key_esc mode "default"
    bindsym $key_mod+$key_r mode "default"
}

bindsym $key_mod+$key_r mode "resize"

# class                 border                       background                   text                         indicator                    child_border
client.focused          $color_primary_fg            $color_primary_fg            $color_primary               $color_primary_fg            $color_primary_fg
client.focused_inactive $color_primary               $color_primary               $color_primary_fg            $color_primary               $color_primary
client.unfocused        $color_secondary             $color_secondary             $color_secondary_fg          $color_secondary             $color_secondary
client.urgent           $color_warn                  $color_warn                  $color_warn_fg               $color_warn                  $color_warn
client.placeholder      $color_info                  $color_info                  $color_info_fg               $color_info                  $color_info
client.background       $color_dark

for_window [class="^.*"] border pixel 1