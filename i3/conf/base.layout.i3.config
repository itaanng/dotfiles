bindsym $key_mod+$key_h split h
bindsym $key_mod+$key_v split v
bindsym $key_mod+$key_t split toggle

bindsym $key_mod+$key_f fullscreen toggle

bindsym $key_mod+$key_s layout stacking
bindsym $key_mod+$key_w layout tabbed
bindsym $key_mod+$key_e layout toggle split
bindsym $key_mod+$key_shift+$key_w sticky toggle

bindsym $key_mod+$key_shift+$key_space floating toggle
bindsym $key_mod+$key_space focus mode_toggle

bindsym $key_mod+$key_a focus parent