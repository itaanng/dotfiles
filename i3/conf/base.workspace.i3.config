# switch to workspace
bindsym $key_mod+1 workspace number $workspace_1
bindsym $key_mod+2 workspace number $workspace_2
bindsym $key_mod+3 workspace number $workspace_3
bindsym $key_mod+4 workspace number $workspace_4
bindsym $key_mod+5 workspace number $workspace_5
bindsym $key_mod+6 workspace number $workspace_6
bindsym $key_mod+7 workspace number $workspace_7
bindsym $key_mod+8 workspace number $workspace_8
bindsym $key_mod+9 workspace number $workspace_9
bindsym $key_mod+0 workspace number $workspace_10

# move focused container to workspace
bindsym $key_mod+$key_shift+1 move container to workspace number $workspace_1
bindsym $key_mod+$key_shift+2 move container to workspace number $workspace_2
bindsym $key_mod+$key_shift+3 move container to workspace number $workspace_3
bindsym $key_mod+$key_shift+4 move container to workspace number $workspace_4
bindsym $key_mod+$key_shift+5 move container to workspace number $workspace_5
bindsym $key_mod+$key_shift+6 move container to workspace number $workspace_6
bindsym $key_mod+$key_shift+7 move container to workspace number $workspace_7
bindsym $key_mod+$key_shift+8 move container to workspace number $workspace_8
bindsym $key_mod+$key_shift+9 move container to workspace number $workspace_9
bindsym $key_mod+$key_shift+0 move container to workspace number $workspace_10

# Switch window/workspace with mod+scroll and mod+shift scroll
bindsym --whole-window --border $key_mod+$key_scroll_up focus left
bindsym --whole-window --border $key_mod+$key_scroll_down focus right
bindsym --whole-window --border $key_mod+$key_shift+$key_scroll_up workspace prev
bindsym --whole-window --border $key_mod+$key_shift+$key_scroll_down workspace next

# Change focus
bindsym $key_mod+$key_left        focus left
bindsym $key_mod+$key_down        focus down
bindsym $key_mod+$key_up          focus up
bindsym $key_mod+$key_right       focus right

# Move focused window
bindsym $key_mod+$key_shift+$key_left  move left
bindsym $key_mod+$key_shift+$key_down  move down
bindsym $key_mod+$key_shift+$key_up    move up
bindsym $key_mod+$key_shift+$key_right move right

# Init default workspaces
workspace $workspace_2 output $output_1
workspace $workspace_1 output $output_2