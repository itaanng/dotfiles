include _*.i3.config

font $font_sm

floating_modifier $key_mod

# start gui screenshot editor
bindsym $key_screenshot exec --no-startup-id $app_screenshot gui

# volume up/down
bindsym $key_volume_up exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym $key_volume_down exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"

## lock screen
bindsym $key_mod+$key_l exec "sleep 0.1 && i3lock --blur 5"

# reload the configuration file
bindsym $key_mod+$key_shift+$key_c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $key_mod+$key_shift+$key_r restart

# exit i3 (logs you out of your X session)
bindsym $key_mod+$key_shift+$key_e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# set randomized wallpapers origin
exec_always --no-startup-id feh --bg-fill --randomize ~/Pictures/Wallpapers/*

# Set dual-monitor config
exec xrandr --output $output_1 --mode 2560x1080 --rate 60 --scale 1x1 --left-of $output_2

exec --no-startup-id $app_notifications
exec --no-startup-id $app_compositor
exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

exec_always mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
