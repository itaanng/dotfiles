include _*.i3.config

bar {
    position               bottom
    mode                   dock
    separator_symbol       " | "
    status_command         i3status
    tray_output            full

    font                   $font_md

    colors {
        background         $color_primary
        statusline         $color_primary_fg
        separator          $color_primary_fg

        active_workspace   $color_info          $color_info          $color_info_fg
        focused_workspace  $color_secondary_fg  $color_secondary_fg  $color_secondary
        inactive_workspace $color_secondary     $color_secondary     $color_secondary_fg
        urgent_workspace   $color_urgent        $color_urgent        $color_urgent_fg
    }
}

exec_always --no-startup-id ~/.config/polybar/launch.sh