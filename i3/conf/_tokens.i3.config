# $color_neutral_100 \ $color_neutral_900
set $color_light                     #e1e4ea
set $color_dark                      #15181e

# $color_blue_500 \ $color_light
set $color_info                      #547fab
set $color_info_fg                   #e1e4ea

# $color_green_500 \ $color_light
set $color_success                   #7da35c
set $color_success_fg                #e1e4ea

# $color_red_300 \ $color_dark
set $color_error                     #d39298
set $color_error_fg                  #15181e

# $color_orange_300 \ $color_dark
set $color_urgent                    #d99e8c
set $color_urgent_fg                 #15181e

# $color_yellow_300 \ $color_dark
set $color_warn                      #e8c47d
set $color_warn_fg                   #15181e

# $color_blue_700 \ $color_blue_300
set $color_primary                   #324c67
set $color_primary_fg                #98b2cd

# $color_green_300 \ $color_green_700
set $color_secondary                 #b1c89d
set $color_secondary_fg              #4b6237

set $border_width                    2
set $gap_width                       5

set $font_sm                         pango:Hack, 9
set $font_md                         pango:Hack, Semibold 11

